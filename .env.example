APP_NAME="Школьные события"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_events
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=redis
SESSION_COOKIE=laravel_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@school-events.ru"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_SUPPORTS_CREDENTIALS=true

# LLM001: keep mock until explicitly configuring and accepting the real provider.
LLM_PROVIDER=mock
LITELLM_BASE_URL=https://litellmru.ds-hub-cf.ru/v1
LITELLM_API_KEY=
LITELLM_MODEL=GigaChat-2-Max
LITELLM_RESPONSE_MODE=json_schema
LITELLM_DISABLE_THINKING=false
LITELLM_TEMPERATURE=0.3
LITELLM_MAX_TOKENS=8000
LITELLM_CONNECT_TIMEOUT=10
LITELLM_TIMEOUT=120
LITELLM_TOTAL_TIMEOUT=240
LITELLM_MAX_ATTEMPTS=2
LITELLM_MAX_RETRY_WAIT=5
LITELLM_REPAIR_PASSES=1
REDIS_QUEUE_RETRY_AFTER=900
