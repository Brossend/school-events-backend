    CALENDAR_EVENTS ||--o{ CULTURAL_CLAIMS : contains
    EVENT_SOURCES ||--o{ SOURCE_REVIEWS : verified_by
    USERS ||--o{ SOURCE_REVIEWS : reviews
    
    CALENDAR_EVENTS ||--o{ CULTURAL_CLAIM_SOURCES : scopes
    CULTURAL_CLAIMS ||--o{ CULTURAL_CLAIM_SOURCES : evidenced_by
