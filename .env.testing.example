APP_NAME="Школьные события (Тестовый контур)"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

# Demo credentials for test contour (optional overrides; when omitted, DatabaseSeeder generates safe isolated test credentials)
DEMO_ADMIN_PASSWORD=
DEMO_CURATOR_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_DIRECTOR_PASSWORD=
DEMO_MULTI_PASSWORD=
DEMO_BLOCKED_PASSWORD=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_events_test
DB_USERNAME=school_test_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_COOKIE=school_events_test_session

CACHE_PREFIX=school_events_test_cache_
REDIS_PREFIX=school_events_test_redis_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=2

FILESYSTEM_PRIVATE_ROOT=storage/app/testing/private

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8001,127.0.0.1:8001,localhost:3000,127.0.0.1:3000

MAIL_MAILER=log
QUEUE_CONNECTION=sync

# LLM001: keep mock until explicitly configuring and accepting the real provider.
LLM_PROVIDER=mock
LITELLM_BASE_URL=https://litellmru.ds-hub-cf.ru/v1
LITELLM_API_KEY=
LITELLM_MODEL=GigaChat-2-Max
LITELLM_RESPONSE_MODE=json_schema
LITELLM_DISABLE_THINKING=false
LITELLM_TEMPERATURE=0.3
LITELLM_MAX_TOKENS=8000
LITELLM_CONNECT_TIMEOUT=10
LITELLM_TIMEOUT=120
LITELLM_TOTAL_TIMEOUT=240
LITELLM_MAX_ATTEMPTS=2
LITELLM_MAX_RETRY_WAIT=5
LITELLM_REPAIR_PASSES=1
REDIS_QUEUE_RETRY_AFTER=900
